{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 340,
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "background": "transparent",
    "view": {"stroke": null},
    "font": "Geist",
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#52666b",
      "titleColor": "#52666b",
      "gridColor": "#e4e9e7",
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 12
    }
  },
  "data": {"url": "data/state_real.csv"},
  "transform": [
    {"filter": {"field": "year_end", "oneOf": [1999, 2025]}}
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {"labelAngle": 0},
      "scale": {"type": "point", "padding": 0, "range": [0, {"expr": "max(0, width - 178)"}]}
    },
    "y": {
      "field": "aquaculture_share",
      "type": "quantitative",
      "title": "Share of local value from farming",
      "scale": {"domain": [0, 1]},
      "axis": {"format": ".0%"}
    },
    "detail": {"field": "state", "type": "nominal"},
    "color": {
      "condition": [
        {"test": "stateFocus !== 'All seven places' && datum.state === stateFocus", "value": "#183b46"},
        {"test": "datum.state === 'Tasmania'", "value": "#183b46"},
        {"test": "datum.state === 'Western Australia'", "value": "#737875"}
      ],
      "value": "#9aa9a5"
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State or territory"},
      {"field": "year", "type": "nominal", "title": "Year"},
      {"field": "aquaculture_share", "type": "quantitative", "title": "Share from farming", "format": ".1%"}
    ],
    "opacity": {
      "condition": {"test": "stateFocus === 'All seven places' || datum.state === stateFocus", "value": 1},
      "value": 0.12
    },
    "strokeWidth": {
      "condition": {
        "test": "stateFocus === 'All seven places' ? indexof(['Tasmania','Western Australia'],datum.state)>=0 : datum.state === stateFocus",
        "value": 3
      },
      "value": 1.4
    }
  },
  "params": [
    {
      "name": "stateFocus",
      "value": "All seven places",
      "bind": {
        "input": "select",
        "options": [
          "All seven places",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory"
        ],
        "name": "Highlight state or territory: "
      }
    }
  ],
  "layer": [
    {"mark": {"type": "line", "point": {"filled": true, "size": 70}}},
    {
      "name": "slope_endpoint_labels",
      "transform": [
        {
          "filter": "toNumber(datum.year_end) === 2025 && (stateFocus === 'All seven places' ? indexof(['Tasmania','Western Australia'],datum.state)>=0 : datum.state === stateFocus)"
        },
        {"calculate": "datum.state+'\\n'+format(datum.aquaculture_share,'.1%')", "as": "endpoint_label"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "lineBreak": "\n",
        "lineHeight": 17,
        "dy": -8,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {"field": "endpoint_label", "type": "nominal"},
        "color": {"value": "#183b46"}
      }
    }
  ],
  "description": "Farming’s share rose in some states and territories and fell in others"
}

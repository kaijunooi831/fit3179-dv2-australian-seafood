{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Geist",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#52666b",
      "titleColor": "#52666b",
      "gridColor": "#e4e9e7",
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 220,
      "columns": 2,
      "symbolSize": 90,
      "padding": 8
    }
  },
  "data": {
    "url": "data/australia_states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -27
    ]
  },
  "transform": [
    {
      "lookup": "properties.state",
      "from": {
        "data": {
          "url": "data/state_map.csv"
        },
        "key": "state",
        "fields": [
          "aquaculture_share",
          "aquaculture_m",
          "wild_m",
          "total_m"
        ]
      }
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "!isValid(datum.aquaculture_share)"
        },
        {
          "calculate": "'No reported production value'",
          "as": "availability"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#cbd1d0",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "availability",
            "type": "nominal",
            "title": "Data"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 1,
        "invalid": null
      },
      "encoding": {
        "color": {
          "field": "aquaculture_share",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              "#edf3ee",
              "#087f83"
            ]
          },
          "legend": {
            "title": [
              "Share of local value",
              "from farming"
            ],
            "format": ".0%",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "aquaculture_share",
            "type": "quantitative",
            "title": "Share from farming",
            "format": ".1%"
          },
          {
            "field": "aquaculture_m",
            "type": "quantitative",
            "title": "Farming value (A$m)",
            "format": ",.1f"
          },
          {
            "field": "wild_m",
            "type": "quantitative",
            "title": "State-managed wild catch (A$m)",
            "format": ",.1f"
          }
        ]
      },
      "transform": [
        {
          "filter": "isValid(datum.aquaculture_share)"
        }
      ]
    },
    {
      "data": {
        "url": "data/state_map.csv"
      },
      "transform": [
        {
          "calculate": "datum.abbrev === 'TAS' ? 'TAS '+format(datum.aquaculture_share, '.1%') : datum.abbrev",
          "as": "map_label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "dy": {
          "expr": "datum.abbrev === 'TAS' ? 18 : 0"
        }
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "map_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.abbrev !== 'TAS' && datum.aquaculture_share > 0.65",
            "value": "white"
          },
          "value": "#183b46"
        }
      }
    }
  ],
  "description": "Tasmania\u2019s production value is overwhelmingly farmed"
}

{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 1000,
  "height": 460,
  "padding": 0,
  "autosize": {"type": "none", "contains": "padding"},
  "background": "transparent",
  "config": {
    "font": "Geist"
  },
  "data": [
    {
      "name": "raw",
      "url": "data/species_latest.csv",
      "format": {"type": "csv", "parse": {"value_m": "number", "share": "number"}},
      "transform": [
        {
          "type": "formula",
          "expr": "({\"Tunas\": \"Finfish, sharks and rays\", \"Salmonids\": \"Finfish, sharks and rays\", \"Other fish\": \"Finfish, sharks and rays\", \"Prawns\": \"Crustaceans\", \"Rock Lobsters\": \"Crustaceans\", \"Crabs\": \"Crustaceans\", \"Other crustaceans\": \"Crustaceans\", \"Abalone\": \"Molluscs\", \"Scallops\": \"Molluscs\", \"Oysters\": \"Molluscs\", \"Squids\": \"Molluscs\", \"Other molluscs\": \"Molluscs\"})[datum.label] || 'root'",
          "as": "parent"
        }
      ]
    },
    {
      "name": "parents",
      "values": [
        {"label": "root", "value_m": 0},
        {"label": "Finfish, sharks and rays", "parent": "root", "value_m": 0},
        {"label": "Crustaceans", "parent": "root", "value_m": 0},
        {"label": "Molluscs", "parent": "root", "value_m": 0}
      ]
    },
    {
      "name": "tree",
      "source": ["raw", "parents"],
      "transform": [
        {"type": "stratify", "key": "label", "parentKey": "parent"},
        {
          "type": "treemap",
          "field": "value_m",
          "sort": {"field": "value", "order": "descending"},
          "method": "squarify",
          "size": [{"signal": "width"}, {"signal": "height"}],
          "paddingInner": 3,
          "paddingOuter": 3,
          "paddingTop": 28,
          "round": true
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {"type": "filter", "expr": "datum.depth === 1 && datum.children"}
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {"type": "filter", "expr": "!datum.children"},
        {
          "type": "formula",
          "expr": "datum.label === 'Other fish' ? ['Other finfish,','sharks and rays'] : datum.label === 'Other industry' ? ['Other','products'] : split(datum.label, ' ')",
          "as": "lines"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Tunas",
        "Salmonids",
        "Other fish",
        "Prawns",
        "Rock Lobsters",
        "Crabs",
        "Other crustaceans",
        "Abalone",
        "Scallops",
        "Oysters",
        "Squids",
        "Other molluscs",
        "Other industry"
      ],
      "range": [
        "#8f6a12",
        "#7356a1",
        "#575077",
        "#406f91",
        "#265d9b",
        "#3b5769",
        "#626a74",
        "#aa4373",
        "#8b4a6a",
        "#934c52",
        "#664754",
        "#7b536c",
        "#60615c"
      ]
    }
  ],
  "marks": [
    {
      "name": "familyFrames",
      "type": "rect",
      "from": {"data": "groups"},
      "encode": {
        "update": {
          "x": {"field": "x0"},
          "x2": {"field": "x1"},
          "y": {"field": "y0"},
          "y2": {"field": "y1"},
          "fill": {"value": "#e9eee4"},
          "stroke": {"value": "#9daa9d"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "name": "familyLabels",
      "type": "text",
      "from": {"data": "groups"},
      "encode": {
        "update": {
          "x": {"signal": "datum.x0+7"},
          "y": {"signal": "datum.y0+18"},
          "text": {"field": "label"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#183b46"}
        }
      }
    },
    {
      "name": "productAreas",
      "type": "rect",
      "from": {"data": "leaves"},
      "encode": {
        "update": {
          "x": {"field": "x0"},
          "x2": {"field": "x1"},
          "y": {"field": "y0"},
          "y2": {"field": "y1"},
          "fill": {"scale": "color", "field": "label"},
          "tooltip": {
            "signal": "{'Group': datum.parent === 'root' ? 'Separately reported' : datum.parent,'Product':datum.label === 'Other industry' ? 'Other products' : datum.species,'A$ million':format(datum.value_m,',.1f'),'Share of national value':format(datum.share,'.1%')}"
          }
        }
      }
    },
    {
      "name": "productLabels",
      "type": "text",
      "interactive": false,
      "from": {"data": "leaves"},
      "encode": {
        "update": {
          "x": {"signal": "datum.x0+7"},
          "y": {"signal": "datum.y0+18"},
          "text": {
            "signal": "datum.y1-datum.y0 > (length(datum.lines)+1)*18+12 ? split(join(datum.lines, '\\n')+'\\n'+format(datum.share,'.1%'), '\\n') : datum.lines"
          },
          "fontSize": {"value": 14},
          "lineHeight": {"value": 18},
          "fill": {"value": "white"},
          "opacity": {
            "signal": "datum.x1-datum.x0 > (datum.label === 'Other fish' ? 112 : 90) && datum.y1-datum.y0 > length(datum.lines)*18+12 ? 1 : 0"
          }
        }
      }
    },
    {
      "name": "nationalLabel",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 3},
          "y": {"value": 12},
          "text": {"value": "National production value · 2024–25"},
          "fontSize": {"value": 13},
          "fill": {"value": "#52666b"}
        }
      }
    }
  ],
  "description": "Salmonids make up 34% of national industry value"
}

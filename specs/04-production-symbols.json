{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 480,
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "background": "transparent",
    "view": {"stroke": null},
    "font": "Geist",
    "legend": {
      "orient": "bottom",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelLimit": 220,
      "columns": 2,
      "symbolSize": 90,
      "padding": 8
    }
  },
  "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-134, 0, 0], "center": [0, -27]},
  "params": [
    {"name": "mapYear", "value": 2025},
    {
      "name": "mapSector",
      "value": "Combined",
      "bind": {"input": "select", "options": ["Combined", "Aquaculture", "Wild catch"], "name": "Production value: "}
    }
  ],
  "layer": [
    {
      "data": {"url": "data/australia_states.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#edf0eb", "stroke": "white", "aria": false}
    },
    {
      "data": {"url": "data/state_map_series.csv"},
      "transform": [
        {"filter": "toNumber(datum.year_end) === mapYear"},
        {
          "calculate": "mapSector === 'Aquaculture' ? datum.aquaculture_m : mapSector === 'Wild catch' ? datum.wild_m : datum.total_m",
          "as": "shown"
        }
      ],
      "mark": {"type": "circle", "color": "#183b46", "fillOpacity": 0.45, "stroke": "#183b46", "strokeWidth": 0.8},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "shown",
          "type": "quantitative",
          "title": "A$ million",
          "scale": {"domain": [0, 2000], "range": [0, 5000], "zero": true},
          "legend": {"values": [100, 500, 2000], "symbolLimit": 3, "columns": 3, "direction": "horizontal"}
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State or territory"},
          {"field": "year", "type": "nominal", "title": "Year"},
          {"field": "shown", "type": "quantitative", "title": "Production value (A$m)", "format": ",.1f"}
        ]
      }
    },
    {
      "data": {"url": "data/state_map_series.csv"},
      "transform": [
        {"filter": "toNumber(datum.year_end) === mapYear && datum.state === 'Victoria'"}
      ],
      "mark": {"type": "rule", "color": "#52666b", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "longitude2": {"datum": 147},
        "latitude2": {"datum": -37.8}
      }
    },
    {
      "data": {"url": "data/state_map_series.csv"},
      "mark": {
        "type": "text",
        "dy": {
          "expr": "datum.state === 'Tasmania' ? 42 : datum.state === 'Victoria' ? 22 : datum.state === 'Queensland' ? -12 : -4"
        },
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#142d34",
        "lineBreak": "\n",
        "lineHeight": 15,
        "dx": {
          "expr": "datum.state === 'Queensland' ? 15 : datum.state === 'Northern Territory' ? -9 : datum.state === 'South Australia' ? -8 : datum.state === 'New South Wales' ? 12 : datum.state === 'Victoria' ? 42 : 0"
        }
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "map_label", "type": "nominal"}
      },
      "transform": [
        {"filter": "toNumber(datum.year_end) === mapYear"},
        {
          "calculate": "replace(replace(replace(datum.state, ' Australia', '\\nAustralia'), ' Territory', '\\nTerritory'), 'New South Wales', 'New South\\nWales')",
          "as": "map_label"
        }
      ]
    }
  ],
  "description": "Production value across seven places in the selected year"
}

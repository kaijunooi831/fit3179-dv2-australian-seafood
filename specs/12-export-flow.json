{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 1000,
  "height": 440,
  "padding": 0,
  "autosize": {"type": "none", "contains": "padding"},
  "background": "transparent",
  "config": {
    "font": "Geist"
  },
  "signals": [
    {"name": "mapHeight", "update": "max(240,min(510,width*0.48))"},
    {"name": "keyY", "update": "mapHeight + 126"},
    {"name": "height", "update": "keyY + 352"},
    {
      "name": "partnerFocus",
      "value": "All selected partners",
      "bind": {
        "input": "select",
        "options": [
          "All selected partners",
          "China",
          "Hong Kong",
          "Japan",
          "United States",
          "Singapore",
          "Vietnam",
          "Taiwan",
          "Indonesia",
          "New Zealand",
          "Thailand",
          "Malaysia"
        ],
        "name": "Show destination: "
      }
    }
  ],
  "data": [
    {"name": "ocean", "values": [{"type": "Sphere"}]},
    {"name": "graticule", "transform": [{"type": "graticule", "step": [30, 30]}]},
    {
      "name": "world",
      "url": "data/world.geojson",
      "format": {"type": "json", "property": "features"},
      "transform": [
        {"type": "filter", "expr": "datum.properties.name !== 'Antarctica'"}
      ]
    },
    {
      "name": "partners",
      "url": "data/partner_map.csv",
      "format": {
        "type": "csv",
        "parse": {
          "value_m": "number",
          "longitude": "number",
          "latitude": "number",
          "origin_longitude": "number",
          "origin_latitude": "number"
        }
      },
      "transform": [
        {"type": "collect", "sort": {"field": "value_m", "order": "descending"}},
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": ["origin_longitude", "origin_latitude"],
          "as": ["startX", "startY"]
        },
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": ["longitude", "latitude"],
          "as": ["endX", "endY"]
        },
        {
          "type": "formula",
          "expr": "datum.partner === 'China' ? 0.32 : datum.partner === 'Malaysia' ? -0.34 : datum.partner === 'Hong Kong' ? 0.12 : datum.partner === 'Singapore' ? -0.2 : datum.partner === 'Vietnam' ? -0.05 : datum.partner === 'Thailand' ? -0.12 : datum.partner === 'Indonesia' ? -0.38 : 0.2",
          "as": "bend"
        },
        {
          "type": "formula",
          "expr": "(datum.startX + datum.endX) / 2 + (datum.endY - datum.startY) * datum.bend",
          "as": "controlX"
        },
        {
          "type": "formula",
          "expr": "(datum.startY + datum.endY) / 2 - (datum.endX - datum.startX) * datum.bend",
          "as": "controlY"
        },
        {
          "type": "formula",
          "expr": "'M' + datum.startX + ',' + datum.startY + ' Q' + datum.controlX + ',' + datum.controlY + ' ' + datum.endX + ',' + datum.endY",
          "as": "curve"
        },
        {
          "type": "formula",
          "expr": "0.0225 * datum.startX + 0.255 * datum.controlX + 0.7225 * datum.endX",
          "as": "arrowX"
        },
        {
          "type": "formula",
          "expr": "0.0225 * datum.startY + 0.255 * datum.controlY + 0.7225 * datum.endY",
          "as": "arrowY"
        },
        {
          "type": "formula",
          "expr": "atan2(0.15 * (datum.controlY - datum.startY) + 0.85 * (datum.endY - datum.controlY), 0.15 * (datum.controlX - datum.startX) + 0.85 * (datum.endX - datum.controlX)) * 180 / PI",
          "as": "angle"
        }
      ]
    },
    {
      "name": "routes",
      "source": "partners",
      "transform": [
        {"type": "filter", "expr": "partnerFocus === 'All selected partners' || datum.partner === partnerFocus"}
      ]
    },
    {
      "name": "labels",
      "source": "partners",
      "transform": [
        {
          "type": "filter",
          "expr": "partnerFocus === 'All selected partners' ? indexof(['China','Malaysia'],datum.partner)>=0 : datum.partner === partnerFocus"
        }
      ]
    },
    {
      "name": "origin",
      "values": [{"longitude": 134.04972, "latitude": -24.129522}],
      "transform": [
        {"type": "geopoint", "projection": "worldProjection", "fields": ["longitude", "latitude"], "as": ["x", "y"]}
      ]
    },
    {"name": "widthKey", "values": [{"value_m": 50, "x": 0}, {"value_m": 200, "x": 100}, {"value_m": 650, "x": 205}]},
    {
      "name": "selectionGuide",
      "source": "routes",
      "transform": [
        {"type": "filter", "expr": "partnerFocus !== 'All selected partners' && scale('flowWidth',datum.value_m) < 1.5"}
      ]
    }
  ],
  "projections": [
    {
      "name": "worldProjection",
      "type": "equalEarth",
      "rotate": [-130, 0, 0],
      "fit": {"signal": "data('ocean')"},
      "extent": {"signal": "[[8,38],[width-8,mapHeight+28]]"}
    }
  ],
  "scales": [
    {"name": "flowWidth", "type": "linear", "domain": [0, 700], "range": [0, 14], "zero": true},
    {
      "name": "barLength",
      "type": "linear",
      "domain": [0, 700],
      "range": {"signal": "[0,max(40,width-178)]"},
      "zero": true
    },
    {
      "name": "rows",
      "type": "band",
      "domain": {"data": "partners", "field": "partner"},
      "range": [0, 286],
      "padding": 0.32
    }
  ],
  "marks": [
    {
      "name": "period",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 0},
          "y": {"value": 15},
          "text": {"value": "2024–25"},
          "fill": {"value": "#183b46"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"}
        }
      }
    },
    {
      "name": "oceanLayer",
      "type": "shape",
      "from": {"data": "ocean"},
      "aria": false,
      "encode": {
        "update": {"fill": {"value": "#dfedf3"}, "stroke": {"value": "#b6cdd7"}, "strokeWidth": {"value": 0.8}}
      },
      "transform": [
        {"type": "geoshape", "projection": "worldProjection"}
      ]
    },
    {
      "name": "graticuleLayer",
      "type": "shape",
      "from": {"data": "graticule"},
      "aria": false,
      "encode": {"update": {"fill": {"value": null}, "stroke": {"value": "#bdcfd7"}, "strokeWidth": {"value": 0.6}}},
      "transform": [
        {"type": "geoshape", "projection": "worldProjection"}
      ]
    },
    {
      "name": "basemap",
      "type": "shape",
      "from": {"data": "world"},
      "aria": false,
      "encode": {
        "update": {"fill": {"value": "#f1f0e6"}, "stroke": {"value": "#b7c1bb"}, "strokeWidth": {"value": 0.6}}
      },
      "transform": [
        {"type": "geoshape", "projection": "worldProjection"}
      ]
    },
    {
      "name": "selectionTrace",
      "type": "path",
      "from": {"data": "selectionGuide"},
      "aria": false,
      "encode": {
        "update": {
          "path": {"field": "curve"},
          "stroke": {"value": "#172f39"},
          "strokeWidth": {"value": 1.5},
          "strokeDash": {"value": [4, 4]},
          "fill": {"value": null},
          "tooltip": {
            "signal": "{'Destination':datum.partner,'Year':'2024–25','Edible exports (A$m)':format(datum.value_m,',.1f')}"
          }
        }
      }
    },
    {
      "name": "flows",
      "type": "path",
      "from": {"data": "routes"},
      "encode": {
        "update": {
          "path": {"field": "curve"},
          "stroke": {"signal": "datum.partner === partnerFocus ? '#172f39' : '#526b78'"},
          "strokeWidth": {"scale": "flowWidth", "field": "value_m"},
          "strokeOpacity": {"value": 0.8},
          "fill": {"value": null},
          "tooltip": {
            "signal": "{'Destination':datum.partner,'Year':'2024–25','Edible exports (A$m)':format(datum.value_m,',.1f')}"
          },
          "description": {
            "signal": "'Australian edible exports to '+datum.partner+': A$'+format(datum.value_m,',.1f')+' million, 2024–25'"
          }
        }
      }
    },
    {
      "name": "arrows",
      "type": "symbol",
      "from": {"data": "routes"},
      "aria": false,
      "encode": {
        "update": {
          "x": {"field": "arrowX"},
          "y": {"field": "arrowY"},
          "shape": {"value": "triangle-right"},
          "angle": {"field": "angle"},
          "size": {"signal": "pow(max(7,scale('flowWidth',datum.value_m)*1.8),2)"},
          "fill": {"signal": "datum.partner === partnerFocus ? '#172f39' : '#526b78'"},
          "opacity": {"value": 0.9}
        }
      }
    },
    {
      "name": "destinations",
      "description": "Destination anchors; hover for the edible export value",
      "type": "symbol",
      "from": {"data": "routes"},
      "encode": {
        "update": {
          "x": {"field": "endX"},
          "y": {"field": "endY"},
          "size": {"value": 22},
          "fill": {"signal": "datum.partner === partnerFocus ? '#172f39' : '#183b46'"},
          "opacity": {"value": 1},
          "tooltip": {
            "signal": "{'Destination':datum.partner,'Year':'2024–25','Edible exports (A$m)':format(datum.value_m,',.1f')}"
          }
        }
      }
    },
    {
      "name": "originDot",
      "type": "symbol",
      "from": {"data": "origin"},
      "aria": false,
      "encode": {
        "update": {"x": {"field": "x"}, "y": {"field": "y"}, "size": {"value": 60}, "fill": {"value": "#183b46"}}
      }
    },
    {
      "name": "originLabel",
      "type": "text",
      "from": {"data": "origin"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y", "offset": 22},
          "text": {"value": "Australia"},
          "align": {"value": "center"},
          "fill": {"value": "#183b46"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"}
        }
      }
    },
    {
      "name": "destinationLabels",
      "type": "text",
      "from": {"data": "labels"},
      "encode": {
        "update": {
          "x": {"signal": "datum.endX+(datum.endX>width*0.7 ? -8 : 8)"},
          "y": {"field": "endY", "offset": -10},
          "text": {"field": "partner"},
          "align": {"signal": "datum.endX>width*0.7 ? 'right' : 'left'"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#183b46"},
          "limit": {"signal": "min(170,width-16)"}
        }
      }
    },
    {
      "name": "legendTitle",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 0},
          "y": {"signal": "mapHeight+63"},
          "text": {"value": "Shaft width = export value (A$m)"},
          "fill": {"value": "#183b46"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"}
        }
      }
    },
    {
      "name": "widthSamples",
      "type": "rule",
      "from": {"data": "widthKey"},
      "aria": false,
      "encode": {
        "update": {
          "x": {"field": "x"},
          "x2": {"field": "x", "offset": 28},
          "y": {"signal": "mapHeight+88"},
          "stroke": {"value": "#526b78"},
          "strokeWidth": {"scale": "flowWidth", "field": "value_m"}
        }
      }
    },
    {
      "name": "widthLabels",
      "type": "text",
      "from": {"data": "widthKey"},
      "encode": {
        "update": {
          "x": {"field": "x", "offset": 35},
          "y": {"signal": "mapHeight+92"},
          "text": {"signal": "format(datum.value_m,',.0f')"},
          "fontSize": {"value": 13},
          "fill": {"value": "#52666b"}
        }
      }
    },
    {
      "name": "rankedKey",
      "type": "group",
      "encode": {
        "update": {"x": {"value": 0}, "y": {"signal": "keyY"}, "width": {"signal": "width"}, "height": {"value": 342}}
      },
      "marks": [
        {
          "name": "rankTitle",
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 0},
              "y": {"value": 0},
              "text": {"value": "Compare all 11 destinations"},
              "fill": {"value": "#183b46"},
              "fontSize": {"value": 14},
              "fontWeight": {"value": "bold"}
            }
          }
        },
        {
          "name": "rankUnits",
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 0},
              "y": {"value": 21},
              "text": {"value": "Edible exports · A$ million"},
              "fill": {"value": "#52666b"},
              "fontSize": {"value": 13}
            }
          }
        },
        {
          "name": "zeroLabel",
          "type": "text",
          "encode": {
            "update": {
              "x": {"value": 118},
              "y": {"value": 341},
              "text": {"value": "0"},
              "fill": {"value": "#52666b"},
              "fontSize": {"value": 13}
            }
          }
        },
        {
          "name": "maxLabel",
          "type": "text",
          "encode": {
            "update": {
              "x": {"signal": "118+scale('barLength',700)"},
              "y": {"value": 341},
              "text": {"value": "700"},
              "fill": {"value": "#52666b"},
              "fontSize": {"value": 13},
              "align": {"value": "right"}
            }
          }
        },
        {
          "name": "keyBaseline",
          "type": "rule",
          "aria": false,
          "encode": {
            "update": {"x": {"value": 118}, "y": {"value": 38}, "y2": {"value": 324}, "stroke": {"value": "#ccd4cb"}}
          }
        },
        {
          "name": "keyRows",
          "type": "rect",
          "from": {"data": "partners"},
          "aria": false,
          "encode": {
            "update": {
              "x": {"value": 0},
              "width": {"signal": "width"},
              "y": {"signal": "38+scale('rows',datum.partner)"},
              "height": {"signal": "bandwidth('rows')"},
              "fill": {"value": "transparent"},
              "tooltip": {
                "signal": "{'Destination':datum.partner,'Year':'2024–25','Edible exports (A$m)':format(datum.value_m,',.1f')}"
              }
            }
          }
        },
        {
          "name": "valueBars",
          "description": "Ranked edible export values for the same eleven destinations, measured from zero",
          "type": "rect",
          "from": {"data": "partners"},
          "encode": {
            "update": {
              "x": {"value": 118},
              "x2": {"signal": "118+scale('barLength',datum.value_m)"},
              "y": {"signal": "38+scale('rows',datum.partner)"},
              "height": {"signal": "bandwidth('rows')"},
              "fill": {"signal": "datum.partner === partnerFocus ? '#172f39' : '#526b78'"},
              "opacity": {
                "signal": "partnerFocus === 'All selected partners' || datum.partner === partnerFocus ? 0.9 : 0.2"
              },
              "tooltip": {
                "signal": "{'Destination':datum.partner,'Year':'2024–25','Edible exports (A$m)':format(datum.value_m,',.1f')}"
              }
            }
          }
        },
        {
          "name": "keyDestinations",
          "type": "text",
          "from": {"data": "partners"},
          "encode": {
            "update": {
              "x": {"value": 0},
              "y": {"signal": "38+scale('rows',datum.partner)+bandwidth('rows')/2"},
              "baseline": {"value": "middle"},
              "text": {"field": "partner"},
              "fontSize": {"value": 13},
              "fill": {"value": "#183b46"},
              "fontWeight": {"signal": "datum.partner === partnerFocus ? 'bold' : 'normal'"}
            }
          }
        },
        {
          "name": "keyValues",
          "type": "text",
          "from": {"data": "partners"},
          "encode": {
            "update": {
              "x": {"signal": "width-3"},
              "y": {"signal": "38+scale('rows',datum.partner)+bandwidth('rows')/2"},
              "align": {"value": "right"},
              "baseline": {"value": "middle"},
              "text": {"signal": "format(datum.value_m,',.1f')"},
              "fontSize": {"value": 13},
              "fill": {"value": "#183b46"},
              "fontWeight": {"signal": "datum.partner === partnerFocus ? 'bold' : 'normal'"}
            }
          }
        }
      ]
    }
  ],
  "description": "Asian destinations lead the selected edible export markets"
}

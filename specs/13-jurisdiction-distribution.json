{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 310,
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {
    "background": "transparent",
    "view": {"stroke": null},
    "font": "Geist",
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#52666b",
      "titleColor": "#52666b",
      "gridColor": "#e4e9e7",
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelLimit": 220,
      "columns": 2,
      "symbolSize": 90,
      "padding": 8
    },
    "numberFormat": ".1%"
  },
  "data": {"url": "data/state_real.csv"},
  "transform": [
    {"filter": {"field": "year_end", "oneOf": [1999, 2010, 2020, 2025]}}
  ],
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 40,
        "color": "#087f83",
        "box": {"fillOpacity": 0.18, "stroke": "#087f83"},
        "median": {"color": "#087f83", "strokeWidth": 2}
      }
    },
    {
      "name": "jurisdiction_observations",
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#183b46",
        "stroke": "#f8f6ef",
        "strokeWidth": 0.7,
        "xOffset": {
          "expr": "(indexof([\"New South Wales\", \"Victoria\", \"Queensland\", \"South Australia\", \"Western Australia\", \"Tasmania\", \"Northern Territory\"], datum.state) - 3) * 4"
        }
      },
      "encoding": {
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State or territory"},
          {"field": "year", "type": "nominal", "title": "Year"},
          {"field": "aquaculture_share", "type": "quantitative", "title": "Share from farming", "format": ".1%"}
        ],
        "opacity": {
          "condition": {"test": "boxFocus === 'All seven places' || datum.state === boxFocus", "value": 0.95},
          "value": 0.2
        },
        "size": {"condition": {"test": "datum.state === boxFocus", "value": 110}, "value": 55}
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelExpr": "[datum.label, datum.label === '1998–99' ? '32.4%' : datum.label === '2009–10' ? '39.0%' : datum.label === '2019–20' ? '49.7%' : datum.label === '2024–25' ? '52.6%' : '']",
        "labelFontSize": 13,
        "labelLineHeight": 17
      }
    },
    "y": {
      "field": "aquaculture_share",
      "type": "quantitative",
      "title": "Farming share",
      "scale": {"domain": [0, 1]},
      "axis": {"format": ".0%"}
    }
  },
  "params": [
    {
      "name": "boxFocus",
      "value": "All seven places",
      "bind": {
        "input": "select",
        "options": [
          "All seven places",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory"
        ],
        "name": "Follow a place: "
      }
    }
  ],
  "description": "The median farming share rose, but regional differences remained"
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Geist",
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#52666b",
      "titleColor": "#52666b",
      "gridColor": "#e4e9e7",
      "domain": false,
      "ticks": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelLimit": 220,
      "columns": 2,
      "symbolSize": 90,
      "padding": 8
    }
  },
  "data": {
    "url": "data/value_change.csv"
  },
  "encoding": {
    "x": {
      "field": "label",
      "type": "ordinal",
      "title": null,
      "sort": {
        "field": "order"
      },
      "axis": {
        "labelAngle": -35,
        "labelLimit": 110,
        "labelPadding": 18
      }
    },
    "y": {
      "field": "start",
      "type": "quantitative",
      "title": "Cumulative change (A$ million)",
      "scale": {
        "zero": true
      }
    },
    "color": {
      "field": "kind",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Total",
          "Increase",
          "Decrease"
        ],
        "range": [
          "#183b46",
          "#566775",
          "#b8bec3"
        ]
      }
    },
    "tooltip": [
      {
        "field": "label",
        "type": "nominal"
      },
      {
        "field": "change",
        "type": "quantitative",
        "title": "Change (A$m)",
        "format": ",.1f"
      },
      {
        "field": "end",
        "type": "quantitative",
        "title": "Cumulative change (A$m)",
        "format": ",.1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#a8b8b0",
        "strokeWidth": 1
      },
      "transform": [
        {
          "filter": "datum.order < 4"
        }
      ],
      "encoding": {
        "x2": {
          "field": "next_label"
        },
        "y": {
          "field": "end",
          "type": "quantitative"
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "value": "#a8b8b0"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "width": {
          "band": 0.55
        }
      },
      "encoding": {
        "y2": {
          "field": "end"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": {
          "expr": "datum.change > 0 ? -9 : 14"
        },
        "color": "#183b46",
        "fontSize": 13
      },
      "encoding": {
        "y": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "change_label",
          "type": "nominal"
        },
        "color": {
          "value": "#183b46"
        }
      }
    }
  ],
  "description": "Rock-lobster gains offset most other category declines"
}
